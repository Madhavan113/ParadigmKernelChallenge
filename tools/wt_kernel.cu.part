
// ---------------------------------------------------------------------------------------------
// Weights-as-A GEMM for small expert blocks (<= 8*NT tokens): out[tok][n] = sum_k W[n][k] x[tok][k]
// with the weight rows as the mma M dimension and the tokens as N, so a block of <= 8 tokens
// costs one m16n8k16 per 16x16 weight tile (no 16-row token padding). One CTA = 4 warps x MW
// m16 weight tiles (GATED: MW gate tiles + the matching MW up tiles) x 8*NT tokens of one
// expert block; K streamed in 128-wide chunks through an NSTAGE cp.async ring (weights, scales
// and the token tile); KS = 2 splits each chunk's 8 k16 steps across two 4-warp groups.
//
// Weight words (repack_weights_wt): per lane and k16 step one 32-bit word holds the 8 nibbles
// of its A fragment, bit-placed so that each f16x2 pair is one shift + one mask:
//   a0 = (w     ) & 0x8E008E00  rows g,   k 2t,2t+1    value = e2m1 * 2^-14
//   a2 = (w << 3) & 0x8E008E00  rows g,   k 2t+8,2t+9  value = e2m1 * 2^-14
//   a1 = (w << 1) & 0x80708070  rows g+8, k 2t,2t+1    value = e2m1 * 2^-19
//   a3 = (w << 2) & 0x801C801C  rows g+8, k 2t+8,2t+9  value = e2m1 * 2^-21
// (fp16 with the sign at bit 15 and the e2m1 bits e1 e0 m at [11-j:9-j] is exactly value * 2^(-14-j),
// subnormals included). The 2^(14+j) is folded into the per-step scale: S = blockscale * gs * 2^(14+j).
// ---------------------------------------------------------------------------------------------

__device__ __forceinline__ uint32_t prmt(uint32_t a, uint32_t b, uint32_t sel) {
    uint32_t r;
    asm("prmt.b32 %0, %1, %2, %3;\n" : "=r"(r) : "r"(a), "r"(b), "r"(sel));
    return r;
}
__device__ __forceinline__ uint32_t e4m3x2_lo16_to_f16x2(uint32_t w) {
    uint32_t r;
    asm("{ .reg .b16 lo, hi; mov.b32 {lo, hi}, %1; cvt.rn.f16x2.e4m3x2 %0, lo; }\n" : "=r"(r) : "r"(w));
    return r;
}
__device__ __forceinline__ uint32_t e4m3x2_hi16_to_f16x2(uint32_t w) {
    uint32_t r;
    asm("{ .reg .b16 lo, hi; mov.b32 {lo, hi}, %1; cvt.rn.f16x2.e4m3x2 %0, hi; }\n" : "=r"(r) : "r"(w));
    return r;
}

constexpr int WT_NWARPS = 4;
__host__ __device__ constexpr int wt_stage_bytes(int tpw, int nt) {
    return tpw * WT_NWARPS * 1024 + tpw * WT_NWARPS * 128 + 8 * nt * A_STRIDE * 2;
}

template <bool GATED, int MW, int NT, int KS, int NSTAGE>
__global__ void __launch_bounds__(128 * KS)
moe_w4a16_wt_kernel(const __half* __restrict__ X, int ldx,
                    const int* __restrict__ sorted_tok,
                    const int* __restrict__ blk_e, const int* __restrict__ blk_row0,
                    const int* __restrict__ blk_end, const int* __restrict__ nblk,
                    const uint8_t* __restrict__ Wr, const uint8_t* __restrict__ Sr, const float* __restrict__ gs,
                    __half* __restrict__ out16, __nv_bfloat16* __restrict__ out_bf, int ldo,
                    int K, int NTILES, float gs_mul, float store_mul)
{
    constexpr int TPW = (GATED ? 2 : 1) * MW;        // m16 weight tiles per warp
    constexpr int TPC = TPW * WT_NWARPS;              // per CTA
    constexpr int W_STAGE = TPC * 1024;
    constexpr int S_STAGE = TPC * 128;
    constexpr int STAGE_BYTES = wt_stage_bytes(TPW, NT);
    constexpr int NTHR = 128 * KS;
    constexpr int CH = NT == 1 ? 2 : 1;               // accumulator chains per tile (latency)
    extern __shared__ __align__(16) uint8_t wt_smem[];

    const int j = blockIdx.y;
    if (j >= *nblk) return;
    const int e = blk_e[j];
    const int row0 = blk_row0[j];
    const int nrows = blk_end[j] - row0;              // valid tokens in this block (<= 8*NT)
    const int ntb = (nrows + 7) >> 3;                 // token n8 blocks in use
    const int tid = threadIdx.x;
    const int warp = (tid >> 5) & 3, lane = tid & 31, gidx = tid >> 7;
    const int g = lane >> 2, t = lane & 3;
    const int NC = K / KC;

    // CTA tile ti (0..TPC-1) -> global m16 tile index
    auto tile_of = [&](int ti) {
        const int w = ti / TPW, i = ti % TPW;
        int tile = (blockIdx.x * WT_NWARPS + w) * MW + (i % MW);
        if (GATED && i >= MW) tile += NTILES / 2;
        return tile;
    };
    const size_t ebase = (size_t)e * NTILES;

    // token rows this thread copies (16 segments of 16B per row per chunk)
    constexpr int XSEG = (NT * 128 + NTHR - 1) / NTHR;
    int xtok[XSEG]; bool xvalid[XSEG];
    #pragma unroll
    for (int i = 0; i < XSEG; ++i) {
        const int s = tid + i * NTHR;
        const int r = s >> 4;
        xvalid[i] = (s < NT * 128) && (r < nrows);
        xtok[i] = xvalid[i] ? (GATED ? sorted_tok[row0 + r] : row0 + r) : 0;
    }

    auto issue = [&](int c, int stage) {
        uint8_t* ws = wt_smem + stage * STAGE_BYTES;
        uint8_t* ss = ws + W_STAGE;
        __half* xs = reinterpret_cast<__half*>(ss + S_STAGE);
        #pragma unroll
        for (int s = tid; s < TPC * 64; s += NTHR) {
            const int ti = s >> 6, off = (s & 63) * 16;
            const uint8_t* src = Wr + ((ebase + tile_of(ti)) * NC + c) * 1024 + off;
            cp_async16(smem_u32(ws + ti * 1024 + off), src, 16);
        }
        if (tid < TPC * 8) {
            const int ti = tid >> 3, off = (tid & 7) * 16;
            const uint8_t* src = Sr + ((ebase + tile_of(ti)) * NC + c) * 128 + off;
            cp_async16(smem_u32(ss + ti * 128 + off), src, 16);
        }
        #pragma unroll
        for (int i = 0; i < XSEG; ++i) {
            const int s = tid + i * NTHR;
            if (s < NT * 128) {
                const int r = s >> 4, seg = s & 15;
                const __half* src = X + (size_t)xtok[i] * ldx + c * KC + seg * 8;
                cp_async16(smem_u32(xs + r * A_STRIDE + seg * 8), src, xvalid[i] ? 16 : 0);
            }
        }
    };

    float acc[TPW][NT * CH][4];
    #pragma unroll
    for (int i = 0; i < TPW; ++i)
        #pragma unroll
        for (int n = 0; n < NT * CH; ++n)
            #pragma unroll
            for (int q = 0; q < 4; ++q) acc[i][n][q] = 0.f;

    const float gsf = gs[e] * gs_mul;                                   // gs * 2^14 (* 2^-m)
    const __half2 gsA_h = __floats2half2_rn(gsf, gsf * 32.f);           // (2^14, 2^19) for rows g / g+8
    const uint32_t gsA = *reinterpret_cast<const uint32_t*>(&gsA_h);
    constexpr uint32_t FOUR2 = 0x44004400u;                             // (4, 4): 2^21 / 2^19

    #pragma unroll
    for (int st = 0; st < NSTAGE - 1; ++st) {
        if (st < NC) issue(st, st);
        cp_async_commit();
    }

    for (int c = 0; c < NC; ++c) {
        cp_async_wait<NSTAGE - 2>();
        __syncthreads();
        {
            const int cn = c + NSTAGE - 1;
            if (cn < NC) issue(cn, cn % NSTAGE);
            cp_async_commit();
        }
        const uint8_t* ws = wt_smem + (c % NSTAGE) * STAGE_BYTES;
        const uint8_t* ss = ws + W_STAGE;
        const __half* xs = reinterpret_cast<const __half*>(ss + S_STAGE);
        #pragma unroll
        for (int hh = 0; hh < 2 / KS; ++hh) {
            const int h = KS == 1 ? hh : gidx;                       // half chunk: k16 steps 4h..4h+3
            uint4 wq[TPW]; uint2 sq[TPW];
            #pragma unroll
            for (int i = 0; i < TPW; ++i) {
                wq[i] = *reinterpret_cast<const uint4*>(ws + ((warp * TPW + i) * 2 + h) * 512 + lane * 16);
                sq[i] = *reinterpret_cast<const uint2*>(ss + (warp * TPW + i) * 128 + g * 16 + h * 8);
            }
            #pragma unroll
            for (int ps = 0; ps < 2; ++ps) {                         // steps 2ps, 2ps+1 of the half
                uint32_t b[NT][4];
                #pragma unroll
                for (int nb = 0; nb < NT; ++nb) {
                    if (nb < ntb)
                        ldmatrix_x4(b[nb][0], b[nb][1], b[nb][2], b[nb][3],
                                    smem_u32(xs + (nb * 8 + (lane & 7)) * A_STRIDE + h * 64 + ps * 32 + (lane >> 3) * 8));
                }
                #pragma unroll
                for (int q = 0; q < 2; ++q) {
                    const int s = 2 * ps + q;
                    #pragma unroll
                    for (int i = 0; i < TPW; ++i) {
                        const uint32_t w = s == 0 ? wq[i].x : s == 1 ? wq[i].y : s == 2 ? wq[i].z : wq[i].w;
                        const uint32_t sw = ps == 0 ? sq[i].x : sq[i].y;
                        uint32_t sp = q == 0 ? e4m3x2_lo16_to_f16x2(sw) : e4m3x2_hi16_to_f16x2(sw);   // (s_g, s_g8)
                        sp = f16x2_mul(sp, gsA);
                        const uint32_t S0 = prmt(sp, sp, 0x1010u);          // row g   scale * 2^14, both halves
                        const uint32_t S1 = prmt(sp, sp, 0x3232u);          // row g+8 scale * 2^19
                        const uint32_t S3 = f16x2_mul(S1, FOUR2);           // row g+8 scale * 2^21
                        uint32_t a[4];
                        a[0] = f16x2_mul(w & 0x8E008E00u, S0);
                        a[2] = f16x2_mul((w << 3) & 0x8E008E00u, S0);
                        a[1] = f16x2_mul((w << 1) & 0x80708070u, S1);
                        a[3] = f16x2_mul((w << 2) & 0x801C801Cu, S3);
                        #pragma unroll
                        for (int nb = 0; nb < NT; ++nb) {
                            if (nb < ntb) mma16816(acc[i][nb * CH + (CH == 2 ? q : 0)], a, b[nb][2 * q], b[nb][2 * q + 1]);
                        }
                    }
                }
            }
        }
    }
    cp_async_wait<0>();

    if (KS == 2) {
        __syncthreads();                                   // the ring is free: reuse it for the reduction
        float* red = reinterpret_cast<float*>(wt_smem);
        if (gidx == 1) {
            #pragma unroll
            for (int i = 0; i < TPW; ++i)
                #pragma unroll
                for (int n = 0; n < NT * CH; ++n)
                    #pragma unroll
                    for (int q = 0; q < 4; ++q) red[((i * NT * CH + n) * 4 + q) * 128 + (tid & 127)] = acc[i][n][q];
        }
        __syncthreads();
        if (gidx == 1) return;
        #pragma unroll
        for (int i = 0; i < TPW; ++i)
            #pragma unroll
            for (int n = 0; n < NT * CH; ++n)
                #pragma unroll
                for (int q = 0; q < 4; ++q) acc[i][n][q] += red[((i * NT * CH + n) * 4 + q) * 128 + (tid & 127)];
    }
    if (CH == 2) {
        #pragma unroll
        for (int i = 0; i < TPW; ++i)
            #pragma unroll
            for (int q = 0; q < 4; ++q) acc[i][0][q] += acc[i][1][q];
    }

    // C fragment: rows (weight rows) g, g+8 of the tile -> output column; cols (tokens) 2t, 2t+1
    #pragma unroll
    for (int i = 0; i < MW; ++i) {
        const int tile = (blockIdx.x * WT_NWARPS + warp) * MW + i;
        #pragma unroll
        for (int nb = 0; nb < NT; ++nb) {
            #pragma unroll
            for (int hr = 0; hr < 2; ++hr) {
                const int col = tile * 16 + g + 8 * hr;
                #pragma unroll
                for (int cc = 0; cc < 2; ++cc) {
                    const int tok = nb * 8 + 2 * t + cc;
                    if (tok >= nrows) continue;
                    const size_t o = (size_t)(row0 + tok) * ldo + col;
                    if (GATED) {
                        const float gv = acc[i][nb * CH][2 * hr + cc], uv = acc[MW + i][nb * CH][2 * hr + cc];
                        const float hv = gv / (1.f + __expf(-gv)) * uv;
                        out16[o] = __float2half(__bfloat162float(__float2bfloat16(hv)) * store_mul);
                    } else {
                        out_bf[o] = __float2bfloat16(acc[i][nb * CH][2 * hr + cc]);
                    }
                }
            }
        }
    }
}

template <bool GATED, int MW, int NT, int KS, int NSTAGE>
void launch_wt(const __half* X, int ldx, const int* st, const int* be, const int* br, const int* bend, const int* nb,
               const uint8_t* Wr, const uint8_t* Sr, const float* gs, __half* o16, __nv_bfloat16* obf, int ldo,
               int K, int ntiles, int max_blocks, float gs_mul, float store_mul, cudaStream_t stream)
{
    constexpr int TPW = (GATED ? 2 : 1) * MW;
    constexpr int smem = NSTAGE * wt_stage_bytes(TPW, NT);
    static bool attr_set = false;
    if (!attr_set) {
        cudaFuncSetAttribute(moe_w4a16_wt_kernel<GATED, MW, NT, KS, NSTAGE>, cudaFuncAttributeMaxDynamicSharedMemorySize, smem);
        attr_set = true;
    }
    const int n_x = (GATED ? ntiles / 2 : ntiles) / (WT_NWARPS * MW);
    dim3 grid(n_x, max_blocks);
    moe_w4a16_wt_kernel<GATED, MW, NT, KS, NSTAGE><<<grid, 128 * KS, smem, stream>>>(
        X, ldx, st, be, br, bend, nb, Wr, Sr, gs, o16, obf, ldo, K, ntiles, gs_mul, store_mul);
}

// post-expert RMSNorm x routing weight, summed per token: grid = tokens, 8 warps (one per route).
__global__ void __launch_bounds__(256)
moe_finalize_kernel(const __nv_bfloat16* __restrict__ y, int ldy, const int* __restrict__ row_of_pair,
                    const float* __restrict__ tw, const float* __restrict__ nw, __nv_bfloat16* __restrict__ out,
                    int H, float eps)
{
    __shared__ float sc_sh[8];
    __shared__ int row_sh[8];
    const int tok = blockIdx.x, warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
    const int r = row_of_pair[tok * 8 + warp];
    float ss = 0.f;
    if (r >= 0) {
        const uint4* src = reinterpret_cast<const uint4*>(y + (size_t)r * ldy);
        const float4* nwp = reinterpret_cast<const float4*>(nw);
        #pragma unroll 4
        for (int seg = lane; seg < H / 8; seg += 32) {
            const uint4 v = src[seg];
            const float4 n0 = nwp[2 * seg], n1 = nwp[2 * seg + 1];
            const __nv_bfloat162* p = reinterpret_cast<const __nv_bfloat162*>(&v);
            float2 f0 = __bfloat1622float2(p[0]), f1 = __bfloat1622float2(p[1]);
            float2 f2 = __bfloat1622float2(p[2]), f3 = __bfloat1622float2(p[3]);
            f0.x *= n0.x; f0.y *= n0.y; f1.x *= n0.z; f1.y *= n0.w;
            f2.x *= n1.x; f2.y *= n1.y; f3.x *= n1.z; f3.y *= n1.w;
            ss += f0.x * f0.x + f0.y * f0.y + f1.x * f1.x + f1.y * f1.y + f2.x * f2.x + f2.y * f2.y + f3.x * f3.x + f3.y * f3.y;
        }
        #pragma unroll
        for (int o = 16; o > 0; o >>= 1) ss += __shfl_xor_sync(0xffffffffu, ss, o);
    }
    if (lane == 0) {
        sc_sh[warp] = r >= 0 ? rsqrtf(ss / (float)H + eps) * tw[tok * 8 + warp] : 0.f;
        row_sh[warp] = r;
    }
    __syncthreads();
    for (int base = threadIdx.x * 8; base < H; base += 256 * 8) {
        float acc[8];
        #pragma unroll
        for (int q = 0; q < 8; ++q) acc[q] = 0.f;
        uint4 v[8];
        #pragma unroll
        for (int s = 0; s < 8; ++s) {
            const int rs = row_sh[s];
            v[s] = rs >= 0 ? *reinterpret_cast<const uint4*>(y + (size_t)rs * ldy + base) : make_uint4(0u, 0u, 0u, 0u);
        }
        #pragma unroll
        for (int s = 0; s < 8; ++s) {
            const float scs = sc_sh[s];
            const __nv_bfloat162* p = reinterpret_cast<const __nv_bfloat162*>(&v[s]);
            #pragma unroll
            for (int q = 0; q < 4; ++q) {
                const float2 f = __bfloat1622float2(p[q]);
                acc[2 * q] += scs * f.x;
                acc[2 * q + 1] += scs * f.y;
            }
        }
        const float4 n0 = *reinterpret_cast<const float4*>(nw + base), n1 = *reinterpret_cast<const float4*>(nw + base + 4);
        __nv_bfloat162 o[4];
        o[0] = __floats2bfloat162_rn(acc[0] * n0.x, acc[1] * n0.y);
        o[1] = __floats2bfloat162_rn(acc[2] * n0.z, acc[3] * n0.w);
        o[2] = __floats2bfloat162_rn(acc[4] * n1.x, acc[5] * n1.y);
        o[3] = __floats2bfloat162_rn(acc[6] * n1.z, acc[7] * n1.w);
        *reinterpret_cast<uint4*>(out + (size_t)tok * H + base) = *reinterpret_cast<const uint4*>(o);
    }
}
